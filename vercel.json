{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/three33 run build",
  "outputDirectory": "artifacts/three33/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
